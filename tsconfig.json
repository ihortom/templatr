{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "commonjs",
        "jsx": "react-jsx",
        "strict": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "sourceMap": true,
        "rootDir": "src",
        "outDir": "dist"
    },
    "include": ["src/**/*"]
}
